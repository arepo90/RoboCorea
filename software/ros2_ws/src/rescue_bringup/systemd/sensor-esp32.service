[Unit]
Description=RoboCorea sensor ESP32 reader (scripts/main.py -> /sensors/thermal + /sensors/mag)
# The sensor DevKit (CH9102 -> /dev/ttyACM0) is deliberately NOT handled by
# esp32-bridge — this standalone script owns it. On every start the script
# opens the port with DTR/RTS deasserted and pulses EN once, so the board
# always boots its app cleanly (no physical reset button, and a jetson.sh
# stop/start cycle doubles as a sensor-board reset).

[Service]
# Must match the workstation/GUI domain. RMW (Zenoh) is inherited from
# /etc/profile.d/ros-rmw-zenoh.sh via `bash -lc` (see scripts/setup-zenoh.sh).
Environment=ROS_DOMAIN_ID=20
# Clock gate: a cold boot starts at 1969 (no RTC battery) and zenoh sessions
# born during large clock skew never stream cross-host again (architecture.md
# §15). Wait for a sane year (chrony from the laptop syncs in seconds; 75 s cap
# stays under the 90 s start timeout), then start anyway so bench work without
# any time source still functions.
ExecStartPre=/bin/bash -c 'i=0; while [ "$$(date +%%Y)" -lt 2025 ]; do [ $$i -ge 75 ] && { echo "WARN: clock unsynced (year $$(date +%%Y)); starting anyway - cross-host ROS streams will be dead until restarted after time sync" >&2; break; }; sleep 1; i=$$((i+1)); done'
# Workspace sourced for mlx90640_msgs (ThermalStatus). %h is $HOME.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source %h/RoboCorea/software/ros2_ws/install/setup.bash && exec python3 %h/RoboCorea/scripts/main.py'
# SIGINT takes the script's clean-shutdown path (serial close with DTR/RTS
# deasserted — the board keeps running its app across restarts of this unit).
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
