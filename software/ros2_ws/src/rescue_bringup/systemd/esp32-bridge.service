[Unit]
Description=RoboCorea ESP32 bridge (serial <-> ROS 2 relay; thermal/mag + wheel odom)
# Always-on core relay: opens BOTH ESP32 USB-serial links (chassis + arm), binds
# them by MSG_BOARD_IDENTITY, and bridges the binary UART protocol to/from ROS 2
# topics. It also republishes the arm-PCB thermal/mag sensors (/sensors/thermal,
# /sensors/mag) and integrates the traction VESC tachometers into /odom/wheel.
# Not PartOf any stack target — it must stay up whenever the robot is on.
#
# The Zenoh router (rmw-zenoh-router.service) is a SYSTEM unit; this is a --user
# unit, so it cannot order against it. That's fine: Zenoh peers auto-retry the
# router connection, so the bridge reconnects once the router is up.

[Service]
# Must match the workstation/GUI domain. RMW (Zenoh) is inherited from
# /etc/profile.d/ros-rmw-zenoh.sh via `bash -lc` (see scripts/setup-zenoh.sh).
Environment=ROS_DOMAIN_ID=20
# Optional explicit serial device for the bridge. Empty (default) => the bridge
# scans serial_candidates (includes /dev/ttyCH341USB* for the WCH CH341 driver
# the Jetson loads for the ESP32 CH340 UARTs). jetson.sh sets this from --serial.
Environment=ROBOCOREA_SERIAL_PORT=
# Adjust the workspace path if yours differs (%h is $HOME).
# serial_candidates is pinned to /dev/ttyCH341USB* (the CH340 ESP32 PCBs) so the
# always-on bridge does NOT open the RPLidar's CP2102 (which enumerates as ttyUSB0
# and is also reachable via /dev/serial/by-id/*). Without this the bridge holds
# ttyUSB0 open waiting for a board identity, and lidar.service (serial_port:=
# /dev/rplidar -> ttyUSB0) fails to init. The glob is double-quoted so bash does
# NOT pre-expand it — the node expands it internally and binds chassis+arm by id.
# Pass serial_port:= ONLY when ROBOCOREA_SERIAL_PORT is non-empty — an empty
# `serial_port:=` is rejected by ros2 launch ("malformed launch argument").
# Clock gate: a cold boot starts at 1969 (no RTC battery) and zenoh sessions
# born during large clock skew never stream cross-host again (architecture.md
# §15). Wait for a sane year (chrony from the laptop syncs in seconds; 75 s cap
# stays under the 90 s start timeout), then start anyway so bench work without
# any time source still functions.
ExecStartPre=/bin/bash -c 'i=0; while [ "$$(date +%%Y)" -lt 2025 ]; do [ $$i -ge 75 ] && { echo "WARN: clock unsynced (year $$(date +%%Y)); starting anyway - cross-host ROS streams will be dead until restarted after time sync" >&2; break; }; sleep 1; i=$$((i+1)); done'
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source %h/RoboCorea/software/ros2_ws/install/setup.bash && exec ros2 launch esp32_bridge esp32_bridge.launch.py serial_candidates:="/dev/ttyCH341USB*" ${ROBOCOREA_SERIAL_PORT:+serial_port:=$ROBOCOREA_SERIAL_PORT}'
# Settle after teardown before any reopen: an instant reopen after an unclean
# close has wedged the tegra-xusb/CH341 stack (EIO on every open until
# scripts/reset-usb-serial.sh). ExecStopPost runs inside `systemctl restart`
# too, so even a hot restart gets this quiet window.
ExecStopPost=/bin/sleep 3
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
